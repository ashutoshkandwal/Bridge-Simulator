{
  "name": "Bridge Simulator Codespace",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",
  "features": {},
  "postCreateCommand": "python -m pip install --upgrade pip && pip install -r requirements.txt && pip install pytest",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "forwardPorts": [5000, 5001],
  "portsAttributes": {
    "5000": {
      "label": "Web ECDIS",
      "onAutoForward": "notify"
    },
    "5001": {
      "label": "Web Radar/Menu",
      "onAutoForward": "notify"
    }
  }
}
